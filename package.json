    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.200.1",
    "braintrust": "^3.24.0",
    "next": "15.5.21",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  }
}
