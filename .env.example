# Fork Around & Find Out — server-side keys only. Never expose these to the client.
# With no keys set, the app runs in deterministic MOCK mode and still fully demos.

# Daytona — the fork/sandbox world. When set, the gate runs on real forks.
DAYTONA_API_KEY=
DAYTONA_API_URL=

# Braintrust — scores the gate's decisions against the golden attack dataset.
BRAINTRUST_API_KEY=

# Agent brain — Fireworks preferred (sponsor), Anthropic fallback.
FIREWORKS_API_KEY=
ANTHROPIC_API_KEY=

# Force deterministic mock even if keys exist (used for stable demo capture).
FAAFO_FORCE_MOCK=
